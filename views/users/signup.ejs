<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-6 offset-lg-3 col-md-8 offset-md-2">
    <div class="form-card">
      <div class="text-center mb-4">
        <div class="badge bg-success-subtle text-success p-3 rounded-circle fs-3 mb-2">
          <i class="fa-solid fa-cubes-stacked"></i>
        </div>
        <h2 class="fw-bold">Join ReBuild<span style="color: var(--primary);">X</span></h2>
        <p class="text-muted">Buy & sell surplus construction materials. Reduce waste and save costs.</p>
      </div>

      <form method="POST" action="<%= basePath %>/signup" class="needs-validation" novalidate>
        <!-- Username -->
        <div class="mb-3">
          <label for="username" class="form-label">Username / Organization Name <span class="text-danger">*</span></label>
          <input type="text" name="username" id="username" required placeholder="e.g. ApexContractors / JohnDoe" class="form-control">
          <div class="invalid-feedback">Please choose a username.</div>
        </div>

        <!-- Email -->
        <div class="mb-3">
          <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
          <input type="email" name="email" id="email" required placeholder="name@company.com" class="form-control">
          <div class="invalid-feedback">Please provide a valid email.</div>
        </div>

        <!-- Phone -->
        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number (For WhatsApp / Inquiries)</label>
          <input type="text" name="phone" id="phone" placeholder="+91 98200 12345" class="form-control">
        </div>

        <!-- Role -->
        <div class="mb-3">
          <label for="role" class="form-label">I am primarily a</label>
          <select name="role" id="role" class="form-select">
            <option value="Contractor" selected>Contractor / Subcontractor</option>
            <option value="Builder">Builder / Real Estate Developer</option>
            <option value="Homeowner">Homeowner / Renovator</option>
            <option value="Buyer">Material Buyer / Trader</option>
            <option value="Recycler">Scrap & Demolition Recycler</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- Password -->
        <div class="mb-4">
          <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
          <input type="password" name="password" id="password" required placeholder="Create a strong password" class="form-control">
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button class="btn btn-primary-action w-100 py-2 fs-6">
          Create Free Account
        </button>

        <div class="text-center mt-3 small text-muted">
          Already have an account? <a href="<%= basePath %>/login" class="fw-bold text-success text-decoration-none">Log in</a>
        </div>
      </form>
    </div>
  </div>
</div>