<% layout("/layouts/boilerplate") %>

<div class="row mt-4 g-4">
  <!-- Main Material Details (Left) -->
  <div class="col-lg-8">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="<%= basePath %>/listing" class="text-decoration-none text-muted">All Materials</a></li>
        <li class="breadcrumb-item"><a href="<%= basePath %>/listing?category=<%= encodeURIComponent(listing.category || '') %>" class="text-decoration-none text-muted"><%= listing.category %></a></li>
        <li class="breadcrumb-item active text-truncate" aria-current="page"><%= listing.title %></li>
      </ol>
    </nav>

    <!-- Title & Location -->
    <h2 class="fw-bold mb-2"><%= listing.title %></h2>
    <p class="text-muted d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-location-dot text-danger"></i>
      <span><%= listing.location %>, <%= listing.country %></span>
      <span>•</span>
      <span class="badge bg-light text-dark border">
        <i class="fa-regular fa-clock me-1"></i>Listed <%= new Date(listing.createdAt || Date.now()).toLocaleDateString("en-IN", { month: 'short', day: 'numeric', year: 'numeric' }) %>
      </span>
    </p>

    <!-- Material Image -->
    <div class="show-img-container position-relative mb-4">
      <img src="<%= listing.image ? listing.image.url : 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=800&q=60' %>" class="show-img-full" alt="<%= listing.title %>">
      <span class="condition-badge" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
        <i class="fa-solid fa-shield-halved me-1"></i><%= listing.condition || 'Surplus' %>
      </span>
      <% if (discountPercent > 0) { %>
        <span class="discount-badge" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
          <%= discountPercent %>% OFF RETAIL
        </span>
      <% } %>
    </div>

    <!-- Specifications Grid -->
    <h4 class="fw-bold mb-3">Material Specifications</h4>
    <div class="specs-grid">
      <div class="spec-card">
        <div class="spec-label">Category</div>
        <div class="spec-val"><%= listing.category || 'Construction' %></div>
      </div>
      <div class="spec-card">
        <div class="spec-label">Condition</div>
        <div class="spec-val"><%= listing.condition || 'Surplus' %></div>
      </div>
      <div class="spec-card">
        <div class="spec-label">Available Quantity</div>
        <div class="spec-val"><%= listing.quantity %> <%= listing.unit || 'Units' %></div>
      </div>
      <div class="spec-card">
        <div class="spec-label">Price per <%= listing.unit ? listing.unit.slice(0, -1) : 'unit' %></div>
        <div class="spec-val text-success">&#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "0" %></div>
      </div>
      <% if (listing.originalPrice && listing.originalPrice > listing.price) { %>
        <div class="spec-card">
          <div class="spec-label">Original Retail Price</div>
          <div class="spec-val text-muted text-decoration-line-through">&#8377;<%= listing.originalPrice.toLocaleString("en-IN") %></div>
        </div>
      <% } %>
      <div class="spec-card">
        <div class="spec-label">Total Lot Estimate</div>
        <div class="spec-val">&#8377;<%= ((listing.price || 0) * (listing.quantity || 1)).toLocaleString("en-IN") %></div>
      </div>
    </div>

    <!-- Description -->
    <div class="my-4">
      <h4 class="fw-bold mb-2">Description & Notes</h4>
      <p class="fs-6 text-secondary" style="white-space: pre-line; line-height: 1.7;">
        <%= listing.description %>
      </p>
    </div>

    <!-- Owner Actions (Edit/Delete) -->
    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
      <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between mb-4">
        <div>
          <span class="fw-bold">You are the seller of this material.</span>
        </div>
        <div class="d-flex gap-2">
          <a href="<%= basePath %>/listing/<%= listing._id %>/edit" class="btn btn-dark btn-sm rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
          </a>
          <form method="POST" action="<%= basePath %>/listing/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this surplus listing?');">
            <button class="btn btn-danger btn-sm rounded-pill px-3">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <hr class="my-4">

    <!-- Reviews Section -->
    <div class="reviews-section">
      <h4 class="fw-bold mb-3">Seller & Material Reviews (<%= listing.reviews.length %>)</h4>

      <% if (currUser) { %>
        <div class="card p-3 border rounded-3 mb-4 bg-white shadow-sm">
          <h5 class="fw-semibold mb-3">Leave a Review</h5>
          <form action="<%= basePath %>/listing/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label d-block">Rating</label>
              <fieldset class="starability-growRotate">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label">Feedback / Inspection Experience</label>
              <textarea id="comment" name="review[comment]" rows="3" class="form-control" placeholder="Share your experience inspecting or collecting this material..." required></textarea>
              <div class="invalid-feedback">Please add some comments for your review.</div>
            </div>

            <button class="btn btn-dark rounded-pill px-4">Submit Review</button>
          </form>
        </div>
      <% } %>

      <!-- All Reviews Grid -->
      <div class="row g-3">
        <% if (listing.reviews.length === 0) { %>
          <div class="col-12">
            <p class="text-muted">No reviews yet for this listing.</p>
          </div>
        <% } %>
        <% for (let review of listing.reviews) { %>
          <div class="col-md-6">
            <div class="card h-100 p-3 border rounded-3 bg-white">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h6 class="fw-bold mb-0">@<%= review.author ? review.author.username : 'Anonymous' %></h6>
                  <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
                </div>
                <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                  <form method="POST" action="<%= basePath %>/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-link text-danger p-0" title="Delete Review">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                <% } %>
              </div>
              <p class="text-secondary small mb-0"><%= review.comment %></p>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sidebar: Seller Contact Hub (Right) -->
  <div class="col-lg-4">
    <div class="seller-hub-card">
      <div class="d-flex justify-content-between align-items-baseline mb-2">
        <div>
          <span class="fs-2 fw-bold text-dark">&#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "0" %></span>
          <span class="text-muted fw-semibold">/ <%= listing.unit ? listing.unit.slice(0, -1) : 'unit' %></span>
        </div>
        <% if (discountPercent > 0) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
            <%= discountPercent %>% Savings
          </span>
        <% } %>
      </div>

      <p class="small text-muted mb-3">
        Total estimated lot: <strong>&#8377;<%= ((listing.price || 0) * (listing.quantity || 1)).toLocaleString("en-IN") %></strong> (<%= listing.quantity %> <%= listing.unit %>)
      </p>

      <!-- Wishlist Action -->
      <% if (currUser) { %>
        <form method="POST" action="<%= basePath %>/listing/<%= listing._id %>/wishlist" class="mb-3">
          <button class="btn w-100 <%= isWishlisted ? 'btn-outline-danger' : 'btn-outline-secondary' %> rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
            <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
            <span><%= isWishlisted ? 'Saved in Wishlist' : 'Save to Wishlist' %></span>
          </button>
        </form>
      <% } %>

      <hr class="my-3">

      <!-- Seller Info -->
      <h6 class="fw-bold mb-2">Seller Contact Details</h6>
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-5">
          <i class="fa-solid fa-helmet-safety"></i>
        </div>
        <div>
          <div class="fw-bold"><%= listing.owner ? listing.owner.username : 'Verified Seller' %></div>
          <div class="text-muted small"><%= (listing.owner && listing.owner.role) || 'Contractor / Builder' %></div>
        </div>
      </div>

      <!-- Contact Buttons -->
      <div class="d-grid gap-2 mb-3">
        <% 
          let rawPhone = listing.contactPhone || (listing.owner && listing.owner.phone) || '';
          let cleanPhone = rawPhone.replace(/[^0-9]/g, '');
          let waMessage = encodeURIComponent(`Hi, I am interested in your ReBuildX surplus listing: "${listing.title}" (${listing.quantity} ${listing.unit} at Rs. ${listing.price}/${listing.unit ? listing.unit.slice(0, -1) : 'unit'}). Is it still available for inspection/pickup?`);
          let email = listing.contactEmail || (listing.owner && listing.owner.email) || 'contact@rebuildx.com';
        %>

        <% if (cleanPhone) { %>
          <a href="https://wa.me/<%= cleanPhone %>?text=<%= waMessage %>" target="_blank" class="btn-whatsapp">
            <i class="fa-brands fa-whatsapp fs-5"></i> Chat on WhatsApp
          </a>

          <a href="tel:<%= rawPhone %>" class="btn-call">
            <i class="fa-solid fa-phone"></i> Call Seller (<%= rawPhone %>)
          </a>
        <% } else { %>
          <a href="https://wa.me/?text=<%= waMessage %>" target="_blank" class="btn-whatsapp">
            <i class="fa-brands fa-whatsapp fs-5"></i> WhatsApp Inquiry
          </a>
        <% } %>

        <a href="mailto:<%= email %>?subject=<%= encodeURIComponent('ReBuildX Material Inquiry: ' + listing.title) %>&body=<%= waMessage %>" class="btn-email">
          <i class="fa-solid fa-envelope"></i> Email Seller
        </a>
      </div>

      <!-- Location & Pickup Notice -->
      <div class="p-3 bg-light rounded-3 border small text-muted">
        <div class="d-flex gap-2 mb-1">
          <i class="fa-solid fa-truck-pickup text-primary mt-1"></i>
          <div><strong>Pickup Location:</strong> <%= listing.location %>, <%= listing.country %></div>
        </div>
        <div class="d-flex gap-2">
          <i class="fa-solid fa-handshake-angle text-success mt-1"></i>
          <div>Inspect materials on-site before finalizing payment.</div>
        </div>
      </div>
    </div>
  </div>
</div>